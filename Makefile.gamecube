.SUFFIXES:
.DEFAULT_GOAL := all

ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment.")
endif

ifeq ($(strip $(DEVKITPPC)),)
$(error "Please set DEVKITPPC in your environment.")
endif

include $(DEVKITPRO)/libogc2/gamecube_rules

PROJECT_DIR := $(patsubst %/,%,$(dir $(abspath $(firstword $(MAKEFILE_LIST)))))
CARRY_ROOT ?= $(abspath $(PROJECT_DIR)/../carryhandle)

TARGET := quake2cube
BUILD  := build-gamecube

SOURCES := \
	$(PROJECT_DIR)/client \
	$(PROJECT_DIR)/qcommon \
	$(PROJECT_DIR)/server \
	$(PROJECT_DIR)/game \
	$(PROJECT_DIR)/ref_soft \
	$(PROJECT_DIR)/other \
	$(PROJECT_DIR)/null \
	$(PROJECT_DIR)/net \
	$(PROJECT_DIR)/sound \
	$(PROJECT_DIR) \
	$(CARRY_ROOT)/source \
	$(CARRY_ROOT)/source/video

CFILES := \
	$(notdir $(wildcard $(PROJECT_DIR)/client/*.c)) \
	$(notdir $(wildcard $(PROJECT_DIR)/qcommon/*.c)) \
	$(filter-out sv_null.c,$(notdir $(wildcard $(PROJECT_DIR)/server/*.c))) \
	$(notdir $(wildcard $(PROJECT_DIR)/game/*.c)) \
	$(notdir $(wildcard $(PROJECT_DIR)/ref_soft/*.c)) \
	q_hunk.c \
	vid_menu.c \
	vid_lib.c \
	q_system.c \
	glob.c \
	cd_null.c \
	net_loopback.c \
	snddma_null.c \
	port_platform_gamecube.c \
	port_soft_gamecube.c \
	ch_dvd.c \
	ch_input.c \
	ch_pad_bus.c \
	ch_time.c \
	ch_video_gamecube.c

CPPFILES :=
sFILES   :=
SFILES   :=

CFLAGS := \
	-g -O2 -Wall \
	-fcommon \
	-Wno-error=incompatible-pointer-types \
	-Dstricmp=strcasecmp \
	-include strings.h \
	-DSDL_MAIN_HANDLED \
	$(MACHDEP) \
	$(INCLUDE)

CXXFLAGS := $(CFLAGS)

LDFLAGS := \
	-g \
	$(MACHDEP) \
	-Wl,-Map,$(notdir $@).map

LIBS := \
	-lSDL2 \
	-lopengx \
	-laesnd \
	-logc \
	-lz \
	-lstdc++ \
	-lm

PROJECT_MAKEFILE := $(PROJECT_DIR)/Makefile.gamecube

export INCLUDE := \
	-I$(CARRY_ROOT)/include \
	-I$(PROJECT_DIR) \
	-I$(PROJECT_DIR)/$(BUILD) \
	-I$(DEVKITPRO)/libogc2/gamecube/include \
	-I$(DEVKITPRO)/libogc2/gamecube/include/SDL2 \
	-I$(DEVKITPRO)/portlibs/ppc/include \
	-I$(LIBOGC_INC)

export LIBPATHS := \
	-L$(DEVKITPRO)/libogc2/gamecube/lib \
	-L$(DEVKITPRO)/portlibs/ppc/lib \
	-L$(LIBOGC_LIB)

include $(CARRY_ROOT)/make/gamecube.mk

ifneq ($(BUILD),$(notdir $(CURDIR)))

.PHONY: clean iso test

clean:
	@echo clean ...
	@rm -rf \
		"$(PROJECT_DIR)/$(BUILD)" \
		"$(PROJECT_DIR)/$(TARGET).elf" \
		"$(PROJECT_DIR)/$(TARGET).dol" \
		"$(PROJECT_DIR)/$(TARGET).iso"

iso: all
	@test -f "$(CARRY_ROOT)/tools/native-gcm/mkdoomcube.py" || \
		( echo "ERROR: missing native GCM builder." && false )
	@test -f "$(CARRY_ROOT)/tools/native-gcm/apploader.bin" || \
		( echo "ERROR: missing apploader.bin." && false )
	@test -f "$(PROJECT_DIR)/baseq2/pak0.pak" || \
		( echo "ERROR: missing baseq2/pak0.pak." && false )

	@rm -rf "$(PROJECT_DIR)/$(BUILD)/disc"
	@mkdir -p "$(PROJECT_DIR)/$(BUILD)/disc"
	@echo "Adding Quake II data"
	@cp -a "$(PROJECT_DIR)/baseq2" "$(PROJECT_DIR)/$(BUILD)/disc/baseq2"

	python3 "$(CARRY_ROOT)/tools/native-gcm/mkdoomcube.py" \
		--dol "$(PROJECT_DIR)/$(TARGET).dol" \
		--apploader "$(CARRY_ROOT)/tools/native-gcm/apploader.bin" \
		--root "$(PROJECT_DIR)/$(BUILD)/disc" \
		--output "$(PROJECT_DIR)/$(TARGET).iso" \
		--title "QUAKE2CUBE" \
		--region PAL

test:
	$(MAKE) -f "$(PROJECT_DIR)/Makefile.gamecube" clean
	$(MAKE) -f "$(PROJECT_DIR)/Makefile.gamecube"
	$(MAKE) -f "$(PROJECT_DIR)/Makefile.gamecube" iso

	@echo
	@echo "Launching Quake2Cube..."
	@echo

	flatpak run \
		--filesystem="$(PROJECT_DIR)" \
		org.DolphinEmu.dolphin-emu \
		-b -e "$(PROJECT_DIR)/$(TARGET).iso"

endif
